<Window x:Class="Asistanim.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Asistanım" Width="560" Height="760" MinWidth="420" MinHeight="520"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <DataTemplate x:Key="EntryTemplate">
            <Border x:Name="card" Margin="0,0,0,8" Padding="12,14" CornerRadius="14" Cursor="Hand"
                    Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
                    Tag="{Binding}"
                    PreviewMouseLeftButtonDown="Card_Down" PreviewMouseMove="Card_Move" PreviewMouseLeftButtonUp="Card_Up">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="⋮⋮" Foreground="#454B63" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Preview}" Foreground="{StaticResource MutedBrush}" FontSize="12.5" Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasDetail}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="›" Foreground="#454B63" FontSize="22" VerticalAlignment="Center" Margin="10,-3,2,0"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" Margin="22,0,0,0" VerticalAlignment="Center">
                <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource AccentGradient}" Margin="0,2,10,0"/>
                <TextBlock Text="Asistanım" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="Bold"/>
                <Border x:Name="DirtyDot" Visibility="Collapsed" Width="8" Height="8" CornerRadius="4" Background="#FFB454"
                        Margin="10,3,0,0" ToolTip="Kaydedilmemiş değişiklikler var"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="SaveBtn" Content="Kaydet" Style="{StaticResource AccentButton}" Padding="14,5" FontSize="12.5"
                        Margin="0,0,10,0" VerticalAlignment="Center" Click="Save_Click" IsEnabled="False"/>
                <Button Style="{StaticResource CaptionButton}" Click="Min_Click" Height="52">
                    <Path Data="M0,0 H10" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.2"/>
                </Button>
                <Button Style="{StaticResource CaptionButton}" Click="Close_Click" Height="52">
                    <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.2"/>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid x:Name="ListPane" Margin="22,4,22,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border CornerRadius="12" Background="#12141C" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
                        Padding="4" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="TabNotes" Content="Notlar" GroupName="t" IsChecked="True" Style="{StaticResource TabButton}" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabIdeas" Content="Fikirler" GroupName="t" Style="{StaticResource TabButton}" Checked="Tab_Checked"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1" Margin="0,16,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox x:Name="AddBox" Style="{StaticResource DarkTextBox}" KeyDown="AddBox_KeyDown" TextChanged="AddBox_TextChanged"/>
                        <TextBlock x:Name="AddHint" Text="Yeni madde ekle…" IsHitTestVisible="False" Foreground="#555B75" FontSize="14"
                                   Margin="16,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <Button Grid.Column="1" Content="＋ Ekle" Style="{StaticResource AccentButton}" Margin="10,0,0,0" Padding="18,0" Click="Add_Click"/>
                </Grid>

                <Grid Grid.Row="2">
                    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="Items" ItemTemplate="{StaticResource EntryTemplate}"/>
                    </ScrollViewer>
                    <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock Text="✦" FontSize="34" Foreground="#343950" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EmptyText" Text="Henüz madde yok" Foreground="#555B75" FontSize="14" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                        <TextBlock Text="Sıralamak için maddeye basılı tut ve sürükle" Foreground="#3F445B" FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid x:Name="DetailPane" Visibility="Collapsed" Margin="22,4,22,18" Background="{StaticResource BgBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Button Content="‹  Geri" Style="{StaticResource PillButton}" HorizontalAlignment="Left" Click="Back_Click"/>
                    <Button Content="Sil" Style="{StaticResource PillButton}" HorizontalAlignment="Right" Foreground="{StaticResource DangerBrush}" Click="Delete_Click"/>
                </Grid>
                <TextBox x:Name="DetTitle" Grid.Row="1" Margin="0,18,0,12" FontSize="20" FontWeight="Bold" Style="{StaticResource DarkTextBox}"
                         TextChanged="Detail_Changed" MaxLength="200"/>
                <Grid Grid.Row="2">
                    <TextBox x:Name="DetBody" Style="{StaticResource DarkTextBox}" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" TextChanged="Detail_Changed"/>
                    <TextBlock x:Name="DetHint" Text="Detaylar, açıklamalar, linkler…" IsHitTestVisible="False" Foreground="#555B75" FontSize="14"
                               Margin="16,13,0,0" VerticalAlignment="Top"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
